<Window x:Class="BlockCraft.NeteaseRoomLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockCraft | 网易房间与账号实验室"
        Width="910" Height="790" MinWidth="820" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#10151F" Foreground="#E9EFF9"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#2F74EA" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#2F74EA" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="#252E3C" />
      <Setter Property="Foreground" Value="#EDF3FC" />
      <Setter Property="BorderBrush" Value="#344357" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#111C2A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#40516A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="27">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="网易手机版联机 · 房间实验室" FontSize="23" FontWeight="Bold" />
      <TextBlock Text="BlockCraft Launcher / C# + WPF + .NET Framework 4.8" Foreground="#A6B7CF" Margin="0,5,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Background="#18283A" BorderBrush="#35506F" BorderThickness="1"
            CornerRadius="8" Padding="15" Margin="0,0,0,17">
      <StackPanel>
        <TextBlock Text="第5–10.4阶段 · 大厅入房、WebRTC 与 SCTP CRC32c 修复实验（非游戏客户端）" Foreground="#80B7FF" FontWeight="SemiBold" FontSize="14" />
        <TextBlock TextWrapping="Wrap" Foreground="#CAD6E7" Margin="0,6,0,0"
                   Text="房间发现与节点查询是只读实验。邮箱认证将由你明确选择的外部助手在本机独立进行；BlockCraft 不读取、上传或打印密码和 Cookie。第三方助手有账号安全与平台条款风险，当前仍无法加入真实世界。" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" CornerRadius="8" Background="#19212D" Padding="18" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,14,0">
          <TextBlock Text="房间号" FontWeight="SemiBold" Margin="0,0,0,7" />
          <TextBox x:Name="RoomIdBox" Text="280474" MaxLength="10" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="查询 UID（可选）" FontWeight="SemiBold" Margin="0,0,0,7" />
          <TextBox x:Name="UidBox" Text="0" MaxLength="10" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,0,0,15">
      <TextBlock Foreground="#97A9C2" TextWrapping="Wrap" Margin="0,0,0,12"
                 Text="查询成功后可尝试把 srv 标记与公开大厅节点列表匹配。UID=0 不代表登录成功；查询节点也不等于加入房间。不要填写密码、Cookie、sessionid 或 token。" />
      <StackPanel Orientation="Horizontal">
        <Button x:Name="LookupButton" Style="{StaticResource PrimaryButton}"
                Click="Lookup_Click" IsDefault="True" Content="查询房间  /  Diagnose" />
        <Button x:Name="NodeLookupButton" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                IsEnabled="False" Click="NodeLookup_Click" Content="查节点映射" />
        <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                Click="ParserCheck_Click" Content="本地解析自检" />
        <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                Click="Copy_Click" Content="复制诊断报告" />
      </StackPanel>
      <ProgressBar x:Name="BusyBar" Margin="0,10,0,0" Height="3"
                   Visibility="Collapsed" IsIndeterminate="True"
                   Foreground="#4288FF" />
    </StackPanel>

    <Border Grid.Row="4" Background="#18212D" BorderBrush="#344357" BorderThickness="1"
            CornerRadius="8" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="网易邮箱账号 · 独立游客登录实验" FontSize="14"
                   FontWeight="SemiBold" Foreground="#A5CBFF"/>
        <TextBlock TextWrapping="Wrap" Foreground="#A9BAD0" Margin="0,6,0,8"
                   Text="请自行审查并选择可信来源的 Opentransfer connect.exe。BlockCraft 不会自动下载或检查其是否受网易认可；登录过程和验证仅在助手窗口中进行。不要在启动器里输入密码或验证码。" />
        <CheckBox x:Name="AuthConsentBox" Foreground="#DFE8F7" Margin="0,0,0,10"
                  Checked="AuthConsent_Changed" Unchecked="AuthConsent_Changed"
                  Content="我了解第三方程序的账号风险，并且只使用本人拥有的第二个账号。" />
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource SecondaryButton}" Click="ChooseAuthHelper_Click"
                  Content="选择 connect.exe" />
          <Button x:Name="EmailAuthButton" Margin="10,0,0,0" IsEnabled="False"
                  Style="{StaticResource PrimaryButton}" Click="EmailAuth_Click"
                  Content="启动网易邮箱登录（本机）" />
          <Button x:Name="AuthDebugButton" Margin="10,0,0,0" IsEnabled="False"
                  Style="{StaticResource SecondaryButton}" Click="CopyAuthDebug_Click"
                  Content="复制认证诊断命令" />
          <Button x:Name="DeleteAuthButton" Margin="10,0,0,0"
                  Style="{StaticResource SecondaryButton}" Click="DeleteAuth_Click"
                  Content="删除本地 Cookie 文件" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="G79VerifyButton" IsEnabled="False"
                  Style="{StaticResource PrimaryButton}" Click="G79Verify_Click"
                  Content="验证第二账号 g79 游戏授权（只检查，不入房）" />
          <TextBlock Margin="12,0,0,0" Foreground="#A9BAD0"
                     VerticalAlignment="Center"
                     Text="不会输出游戏 token 或登录凭据。" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
          <Button Style="{StaticResource SecondaryButton}" Click="AdmissionSchema_Click"
                  Content="第七阶段 · 准入回执格式自检（离线）" />
          <TextBlock Foreground="#A9BAD0" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="无真实准入服务，不读取 Cookie，也不连接手机。" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
          <Button x:Name="LivePreflightButton" IsEnabled="False"
                  Style="{StaticResource PrimaryButton}" Click="LivePreflight_Click"
                  Content="第八阶段 · 用第二账号预检真实房间连接参数（不入房）" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
          <Button x:Name="RealJoinButton" IsEnabled="False"
                  Style="{StaticResource PrimaryButton}" Click="RealJoin_Click"
                  Content="第九阶段 · 真实 RakNet 大厅登录并申请入房（一次）" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="#D5B682" Margin="0,5,0,0"
                   Text="此按钮会向网易服务器发送真实登录与入房请求。只对自己创建或已获得房主许可的房间使用；探针退出时会离开房间，尚不能加载游戏世界。" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="RealWebRTCButton" IsEnabled="False"
                  Style="{StaticResource PrimaryButton}" Click="RealWebRTC_Click"
                  Content="第十阶段 10.5 · 稳定连接手机房主（一次）" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="CancelProbeButton" IsEnabled="False" Click="CancelProbe_Click"
                  Content="停止连接测试并清理会话" Padding="16,9"
                  Background="#8B3740" Foreground="White" BorderThickness="0" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="#D5B682" Margin="0,5,0,0"
                   Text="先完成真实服务器入房，再连接信令 WebSocket 并协商 ICE/DTLS/SCTP。只测试你自己的或获许可的房间；不会发送 Minecraft 游戏包。取消将结束探针，不代表服务器已完成离房。" />
        <TextBlock x:Name="RealWebRTCStatusText" Foreground="#BFD5F4" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="WEBRTC_PROBE_NOT_RUN：未尝试与手机房主建立真实游戏传输。" />
        <TextBlock x:Name="RealJoinStatusText" Foreground="#BFD5F4" TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Text="JOIN_PROBE_NOT_RUN：还没有进行真实大厅登录或入房验证。" />
        <TextBlock x:Name="LivePreflightStatusText" Foreground="#BFD5F4"
                   TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="LIVE_PREFLIGHT_NOT_RUN：尚未用第二账号查询当前真实房间及构造临时连接材料。" />
        <TextBlock x:Name="AdmissionStatusText" Foreground="#C4D0E5" Margin="0,8,0,0"
                   TextWrapping="Wrap" Text="ADMISSION_PROVIDER_NOT_CONFIGURED：尚未获取真实房间入场授权。" />
        <TextBlock x:Name="AuthStatusText" Foreground="#C4D0E5" Margin="0,9,0,0"
                   TextWrapping="Wrap" Text="未选择认证组件。当前状态：AUTH_NOT_CONFIGURED。" />
      </StackPanel>
    </Border>

    <Border Grid.Row="5" Background="#0D1724" CornerRadius="8" Padding="16" Height="215">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" FontWeight="SemiBold"
                   Foreground="#A8BAD3" Margin="0,0,0,12"
                   Text="等待执行 · 未查询网络" />
        <TextBox x:Name="ResultBox" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 Text="请点击“查询房间”开始一次网络元数据查询。&#10;&#10;也可以先点击“本地解析自检”验证程序的 JSON 解析能力（不会访问服务器）。" />
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="6" Margin="0,14,0,0" Foreground="#889CB7"
               TextWrapping="Wrap"
               Text="状态必须区分：文件已保存 ≠ 账号被验证 ≠ 获得入房许可 ≠ 进入世界。实验不需要网易 PC 客户端。" />
  </Grid>
  </ScrollViewer>
</Window>
