<Window x:Class="BlockCraftLauncher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockCraft Launcher · WPF 迁移预览" Height="800" Width="1230"
        MinHeight="520" MinWidth="780" WindowStartupLocation="CenterScreen"
        Icon="Assets/blockcraft_icon.ico" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <ScrollViewer x:Name="WindowViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                Background="{DynamicResource WindowBrush}" SizeChanged="WindowViewport_SizeChanged">
    <Grid x:Name="Shell" MinWidth="960" MinHeight="640">
      <Grid.LayoutTransform><ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" Padding="20,14,20,10">
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
            <Image Source="Assets/blockcraft_icon.png" Height="34" Width="34" Margin="0,0,10,0"/>
            <TextBlock Text="BlockCraft Launcher" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Right" Text="WPF / .NET Framework 4.8 · 迁移预览" FontSize="12"
                     Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Margin="12,0,12,0">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="SideBar" Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" Padding="10" Margin="0,0,12,0">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SideMenu"/>
          </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch"/>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource WindowBrush}" Padding="18,10,18,13">
        <DockPanel>
          <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Text="就绪" FontSize="12"
                     Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="v0.9.27 WPF Alpha" DockPanel.Dock="Right" FontSize="11"
                     Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
        </DockPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
