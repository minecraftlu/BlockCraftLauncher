<Window x:Class="BlockCraftLauncher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource {x:Type Window}}"
        Title="BlockCraft Launcher · Minecraft Java 启动器"
        Width="960" Height="600" MinWidth="640" MinHeight="420" MaxWidth="960" MaxHeight="600"
        ResizeMode="CanMinimize"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Icon="Assets/blockcraft_icon.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0"
                        GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="26"/>
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource TitleBarBrush}">
      <Grid Margin="12,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel x:Name="HeaderBrand" VerticalAlignment="Center" Margin="2,0,8,0" IsHitTestVisible="False">
          <Image DockPanel.Dock="Left" Source="Assets/blockcraft_icon.png" Width="23" Height="23" Margin="0,0,7,0"/>
          <TextBlock Text="BlockCraft Launcher" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <StackPanel x:Name="TopNavigation" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="TopLaunchButton" Style="{StaticResource HeaderTab}" AutomationProperties.Name="启动">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE768;" Style="{StaticResource HeaderGlyph}"/>
              <TextBlock Text="启动" Style="{StaticResource HeaderLabel}"/>
            </StackPanel>
          </Button>
          <Button x:Name="TopDownloadButton" Style="{StaticResource HeaderTab}" AutomationProperties.Name="下载">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" Style="{StaticResource HeaderGlyph}"/>
              <TextBlock Text="下载" Style="{StaticResource HeaderLabel}"/>
            </StackPanel>
          </Button>
          <Button x:Name="TopMultiplayerButton" Style="{StaticResource HeaderTab}" AutomationProperties.Name="联机">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE902;" Style="{StaticResource HeaderGlyph}"/>
              <TextBlock Text="联机" Style="{StaticResource HeaderLabel}"/>
            </StackPanel>
          </Button>
          <Button x:Name="TopSettingsButton" Style="{StaticResource HeaderTab}" AutomationProperties.Name="设置">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" Style="{StaticResource HeaderGlyph}"/>
              <TextBlock Text="设置" Style="{StaticResource HeaderLabel}"/>
            </StackPanel>
          </Button>
          <Button x:Name="TopMoreButton" Style="{StaticResource HeaderTab}" AutomationProperties.Name="更多">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE712;" Style="{StaticResource HeaderGlyph}"/>
              <TextBlock Text="更多" Style="{StaticResource HeaderLabel}"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <Grid x:Name="ContextNavigation" Grid.ColumnSpan="3" Margin="0,0,100,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BackButton" Style="{StaticResource HeaderTab}" MinWidth="0"
                  Click="BackButton_Click" AutomationProperties.Name="返回">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72B;" Style="{StaticResource HeaderGlyph}"/>
              <TextBlock Text="返回" Style="{StaticResource HeaderLabel}"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="ContextTitle" Grid.Column="1" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center"
                     Margin="10,0,12,0" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource CaptionButton}" ToolTip="最小化"
                  AutomationProperties.Name="最小化" Click="MinimizeButton_Click">
            <TextBlock Style="{StaticResource HeaderGlyph}" Margin="0" Text="&#xE921;"/>
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Visibility="Collapsed"
                  IsEnabled="False" ToolTip="已锁定窗口尺寸" AutomationProperties.Name="窗口尺寸已锁定"
                  Click="MaximizeButton_Click">
            <TextBlock x:Name="MaximizeGlyph" Style="{StaticResource HeaderGlyph}" Margin="0" Text="&#xE922;"/>
          </Button>
          <Button Style="{StaticResource CaptionButton}" ToolTip="关闭"
                  AutomationProperties.Name="关闭" Click="CloseButton_Click">
            <TextBlock Style="{StaticResource HeaderGlyph}" Margin="0" Text="&#xE8BB;"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="WindowViewport" Grid.Row="1" ClipToBounds="True"
            Background="{DynamicResource PageBrush}" SizeChanged="WindowViewport_SizeChanged">
      <Grid x:Name="Shell">
        <Grid.LayoutTransform>
          <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SideColumn" Width="156"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="SideBar" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,0,1,0">
          <Grid>
            <ContentControl x:Name="LaunchPane" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
            <ScrollViewer x:Name="SideMenuScroll"
                          Visibility="{Binding Visibility, ElementName=SideMenu}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="SideMenu" Margin="0,11,0,10"/>
            </ScrollViewer>
          </Grid>
        </Border>
        <ScrollViewer x:Name="PageScroll" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16,14,16,8">
          <Grid>
            <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top"/>
            <ContentControl x:Name="DetailHost" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top" Visibility="Collapsed"/>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" Padding="12,0,8,0"
            BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="True">
        <Button x:Name="TaskShortcut" DockPanel.Dock="Right" Style="{StaticResource FooterButton}"
                AutomationProperties.Name="打开下载任务">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0"/>
            <TextBlock Text="下载任务"/>
          </StackPanel>
        </Button>
        <Button x:Name="PostponeUpdateButton" DockPanel.Dock="Right"
                Style="{StaticResource FooterButton}" Visibility="Collapsed"
                Content="稍后更新" ToolTip="暂缓自动关闭旧版并打开新版"/>
        <TextBlock x:Name="BuildVersionText" DockPanel.Dock="Right" Margin="0,0,12,0"
                   FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Margin="0,0,12,0"
                   Foreground="{DynamicResource MutedBrush}" FontSize="11"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
