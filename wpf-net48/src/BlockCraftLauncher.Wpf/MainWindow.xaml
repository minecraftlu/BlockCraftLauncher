<Window x:Class="BlockCraftLauncher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockCraft Launcher · Minecraft 启动器"
        Width="1180" Height="770" MinWidth="870" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/blockcraft_icon.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- Only the sidebar and the active content page scroll at normal scale.
       The outer viewport scrolls only if the user explicitly zooms beyond
       the supported window area; this removes the screenshot's three bars. -->
  <ScrollViewer x:Name="WindowViewport"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Background="{DynamicResource WindowBrush}"
                SizeChanged="WindowViewport_SizeChanged">
    <Grid x:Name="Shell" MinWidth="840" MinHeight="580">
      <Grid.LayoutTransform>
        <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
      </Grid.LayoutTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="60"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="32"/>
      </Grid.RowDefinitions>

      <!-- Clear PCL-style primary navigation. The app name and logo remain
           BlockCraft's own; all existing feature pages are retained. -->
      <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Image Source="Assets/blockcraft_icon.png" Width="34" Height="34"
                   Margin="0,0,9,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="BlockCraft" Foreground="{DynamicResource HeaderTextBrush}"
                         FontWeight="SemiBold" FontSize="18"/>
              <TextBlock Text="独立开发的 Minecraft Java 启动器"
                         Foreground="#D8EDFF" FontSize="10" Margin="0,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Button x:Name="TopLaunchButton" Style="{StaticResource HeaderTab}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Margin="0,0,7,0"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock Text="启动" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
            <Button x:Name="TopDownloadButton" Style="{StaticResource HeaderTab}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Margin="0,0,7,0"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock Text="下载" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
            <Button x:Name="TopSettingsButton" Style="{StaticResource HeaderTab}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Margin="0,0,7,0"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock Text="设置" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
            <Button x:Name="TopMoreButton" Style="{StaticResource HeaderTab}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Margin="0,0,7,0"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock Text="更多" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="BlockCraft" FontSize="10" FontWeight="SemiBold"
                     Foreground="#D5EBFE" Margin="12,0,0,0"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Background="{DynamicResource PageBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SideColumn" Width="188"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="SideBar" Grid.Column="0" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource BorderBrushTheme}"
                Background="{DynamicResource PanelBrush}" Padding="8,16,7,8">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SideMenu"/>
          </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="PageScroll" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="23,20,23,14">
          <ContentControl x:Name="PageHost"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Top"/>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource WindowBrush}"
              BorderBrush="{DynamicResource BorderBrushTheme}"
              BorderThickness="0,1,0,0" Padding="15,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" Text="就绪"
                     Foreground="{DynamicResource MutedBrush}" FontSize="11"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="BlockCraft  ·  v0.9.32 WPF 预览"
                     FontSize="10" Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
