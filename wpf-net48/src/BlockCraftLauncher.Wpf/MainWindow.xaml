<Window x:Class="BlockCraftLauncher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockCraft Launcher · Minecraft 启动器"
        Width="1200" Height="800" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/blockcraft_icon.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- Only the sidebar and the active content page scroll at normal scale.
       The outer viewport scrolls only if the user explicitly zooms beyond
       the supported window area; this removes the screenshot's three bars. -->
  <ScrollViewer x:Name="WindowViewport"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Background="{DynamicResource WindowBrush}"
                SizeChanged="WindowViewport_SizeChanged">
    <Grid x:Name="Shell" MinWidth="840" MinHeight="580">
      <Grid.LayoutTransform>
        <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
      </Grid.LayoutTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="66"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="36"/>
      </Grid.RowDefinitions>

      <!-- Clear PCL-style primary navigation. The app name and logo remain
           BlockCraft's own; all existing feature pages are retained. -->
      <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}">
        <Grid Margin="22,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Image Source="Assets/blockcraft_icon.png" Width="37" Height="37"
                   Margin="0,0,11,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="BlockCraft" Foreground="{DynamicResource HeaderTextBrush}"
                         FontWeight="Bold" FontSize="19"/>
              <TextBlock Text="Minecraft Java 启动器"
                         Foreground="#D8EDFF" FontSize="11" Margin="0,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Button x:Name="TopLaunchButton" Content="▶  启动" Style="{StaticResource HeaderTab}"/>
            <Button x:Name="TopDownloadButton" Content="⇩  下载" Style="{StaticResource HeaderTab}"/>
            <Button x:Name="TopSettingsButton" Content="⚙  设置" Style="{StaticResource HeaderTab}"/>
            <Button x:Name="TopMoreButton" Content="▦  更多" Style="{StaticResource HeaderTab}"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="WPF" FontSize="10" FontWeight="Bold"
                     Foreground="#D5EBFE" Margin="14,0,0,0"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Background="{DynamicResource PageBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SideColumn" Width="205"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="SideBar" Grid.Column="0" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource BorderBrushTheme}"
                Background="{DynamicResource PanelBrush}" Padding="13,17,10,10">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SideMenu"/>
          </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="PageScroll" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,21,20,14">
          <ContentControl x:Name="PageHost"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Top"/>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource WindowBrush}"
              BorderBrush="{DynamicResource BorderBrushTheme}"
              BorderThickness="0,1,0,0" Padding="15,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" Text="就绪"
                     Foreground="{DynamicResource MutedBrush}" FontSize="11"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="BlockCraft  ·  v0.9.27 WPF Alpha"
                     FontSize="10" Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
