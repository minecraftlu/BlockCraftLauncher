<Application x:Class="BlockCraftLauncher.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#F6F9FF"/>
    <SolidColorBrush x:Key="PageBrush" Color="#E8F1FD"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FCFDFF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#F2F7FF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#374258"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#637389"/>
    <SolidColorBrush x:Key="BorderBrushTheme" Color="#CBD9EB"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EAF2FE"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1370F3"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#0B5BCB"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0.5" EndPoint="1,0.5">
      <GradientStop Color="#226ACC" Offset="0"/>
      <GradientStop Color="#4386E8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BadgeBrush" Color="#E0EAFD"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#4890F5"/>
    <SolidColorBrush x:Key="SoftDividerBrush" Color="#E2EAF5"/>
    <SolidColorBrush x:Key="SearchSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#24785D"/>
    <SolidColorBrush x:Key="PreviewFloorBrush" Color="#DAE8FB"/>
    <LinearGradientBrush x:Key="FeaturePanelBrush" StartPoint="0,0" EndPoint="1,0.5">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#EDF6FF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HeaderSelectionBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderSelectionTextBrush" Color="#0B5BCB"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#B8C9DF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#BA4052"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#8C5D0A"/>
    <DropShadowEffect x:Key="CardShadow" Color="#536C95" BlurRadius="8"
                      ShadowDepth="1" Direction="270" Opacity="0.10" RenderingBias="Performance"/>

    <Style x:Key="KeyboardFocusOutline">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="2" RadiusX="4" RadiusY="4" StrokeDashArray="2 2"
                       Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="1.5"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Window">
      <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="TextTrimming" Value="None"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusOutline}"/>
      <Setter Property="Margin" Value="0,0,8,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4"/>
              <Border x:Name="ButtonHover" Background="Transparent" CornerRadius="4"/>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="ButtonHover" Property="Background" Value="#121370F3"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonHover" Property="Background" Value="#251370F3"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="LaunchButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="55"/>
      <Setter Property="MaxWidth" Value="Infinity"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="HeaderLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HeaderGlyph" TargetType="TextBlock" BasedOn="{StaticResource HeaderLabel}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="HeaderTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinWidth" Value="62"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="5,0"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="14" Background="{TemplateBinding Background}"/>
              <Border x:Name="TabHover" CornerRadius="14" Background="Transparent"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabHover" Property="Background" Value="#29FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TabHover" Property="Background" Value="#29000000"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabHover" Property="BorderBrush" Value="{DynamicResource HeaderTextBrush}"/>
                <Setter TargetName="TabHover" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HeaderTabActive" TargetType="Button" BasedOn="{StaticResource HeaderTab}">
      <Setter Property="Background" Value="{DynamicResource HeaderSelectionBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource HeaderSelectionTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource HeaderTab}">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="29"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="27"/>
      <Setter Property="Padding" Value="9,2"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="SidebarItem" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="15,0,8,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavRow" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavRow" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="NavRow" Property="Background" Value="{DynamicResource SelectedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarItemActive" TargetType="Button" BasedOn="{StaticResource SidebarItem}">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SoftDividerBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="15,12,15,10"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>
    <Style x:Key="FeaturePanel" TargetType="Border" BasedOn="{StaticResource Panel}">
      <Setter Property="Background" Value="{DynamicResource FeaturePanelBrush}"/>
      <Setter Property="Padding" Value="16,14,16,12"/>
    </Style>
    <Style x:Key="HomeAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SoftDividerBrush}"/>
    </Style>
    <Style x:Key="AccountMode" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="Margin" Value="1"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusOutline}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Mode" Background="Transparent" CornerRadius="13" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Mode" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mode" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SkinMetaBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Margin" Value="0,0,6,5"/>
      <Setter Property="Padding" Value="7,3"/>
    </Style>
    <!-- Shared PCL-style search and download layouts. Distinct original
         visual assets, same familiar label/filter/results information flow. -->
    <Style x:Key="SearchPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
      <Setter Property="Padding" Value="14,12,14,7"/>
      <Setter Property="Background" Value="{DynamicResource SearchSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}"/>
    </Style>
    <Style x:Key="ResultsPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
      <Setter Property="Padding" Value="13,11,13,8"/>
    </Style>
    <Style x:Key="SectionCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="11,4"/>
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SoftDividerBrush}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="29"/>
      <Setter Property="Margin" Value="0,0,8,7"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Input" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Input" Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Input" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.56"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Option" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Option" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Option" Property="Background" Value="{DynamicResource SelectedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="29"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusOutline}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboSurface" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter x:Name="Selection" Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True"/>
                  <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="Transparent"
                           BorderThickness="0" Padding="{TemplateBinding Padding}" Margin="0"
                           Foreground="{TemplateBinding Foreground}" MinHeight="0"
                           IsReadOnly="{TemplateBinding IsReadOnly}"/>
                  <ToggleButton x:Name="DropToggle" Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                          <Path Data="M 0 0 L 4 4 L 8 0" StrokeThickness="1.5"
                                Stroke="{DynamicResource MutedBrush}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </Grid>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=ComboSurface}"
                     AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushTheme}"
                        BorderThickness="1" CornerRadius="4" Padding="3"
                        MinWidth="{Binding ActualWidth, ElementName=ComboSurface}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                <Setter TargetName="DropToggle" Property="Grid.Column" Value="1"/>
                <Setter TargetName="DropToggle" Property="Grid.ColumnSpan" Value="1"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.50"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style x:Key="SearchComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="9,4"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="SelectionChrome" Background="{TemplateBinding Background}"
                    CornerRadius="4" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SelectionChrome" Property="Background"
                        Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectionChrome" Property="Background"
                        Value="{DynamicResource SelectedBrush}"/>
                <Setter TargetName="SelectionChrome" Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,3,12,8"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusOutline}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="CheckFrame" Width="15" Height="15" HorizontalAlignment="Left"
                      VerticalAlignment="Center" CornerRadius="3" BorderThickness="1"
                      BorderBrush="{DynamicResource InputBorderBrush}"
                      Background="{DynamicResource PanelBrush}">
                <Grid>
                  <Path x:Name="Tick" Data="M 0,4 L 3,7 8,1" StrokeThickness="1.5" Visibility="Collapsed"
                        Stroke="{DynamicResource AccentTextBrush}" StrokeLineJoin="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Rectangle x:Name="Dash" Fill="{DynamicResource AccentInkBrush}" Width="7" Height="2"
                             Visibility="Collapsed"/>
                </Grid>
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckFrame" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="CheckFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.52"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3">
              <Grid x:Name="PART_Track" ClipToBounds="True">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                        HorizontalAlignment="Left" CornerRadius="3"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard Name="Pulse">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity"
                                       From="0.38" To="1" Duration="0:0:0.66"
                                       AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <RemoveStoryboard BeginStoryboardName="Pulse"/>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Opacity" Value="0.32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="PreviousPage" Command="{x:Static ScrollBar.PageUpCommand}"
                              Style="{StaticResource ScrollTrackButton}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Grip" Background="{DynamicResource SecondaryAccentBrush}" CornerRadius="2.5"
                              Width="5" HorizontalAlignment="Right" Margin="0,1,2,1"/>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                          <Setter TargetName="Grip" Property="Width" Value="Auto"/>
                          <Setter TargetName="Grip" Property="Height" Value="5"/>
                          <Setter TargetName="Grip" Property="HorizontalAlignment" Value="Stretch"/>
                          <Setter TargetName="Grip" Property="VerticalAlignment" Value="Bottom"/>
                          <Setter TargetName="Grip" Property="Margin" Value="1,0,1,2"/>
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="NextPage" Command="{x:Static ScrollBar.PageDownCommand}"
                              Style="{StaticResource ScrollTrackButton}"/>
              </Track.IncreaseRepeatButton>
            </Track>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="PreviousPage" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                <Setter TargetName="NextPage" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="8"/>
        </Trigger>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="8"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="1"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusOutline}"/>
    </Style>

    <DataTemplate x:Key="ProfileItemTemplate">
      <Border Padding="8,6" BorderBrush="{DynamicResource SoftDividerBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                     Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <WrapPanel Margin="0,3,0,0">
              <TextBlock Text="{Binding BaseVersion}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,9,0"/>
              <TextBlock Foreground="{DynamicResource MutedBrush}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{Binding Loader}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Loader}" Value="vanilla">
                        <Setter Property="Text" Value="原版"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </WrapPanel>
            <TextBlock Text="{Binding Directory}" Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}" FontSize="11"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <!-- Public server search: text only; no untrusted remote image URLs are
         automatically loaded from catalogue listings. -->
    <DataTemplate x:Key="PublicServerResultTemplate">
      <Border Padding="9,8" BorderBrush="{DynamicResource BorderBrushTheme}"
              BorderThickness="0,0,0,1" MinHeight="76" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="4"
                  Background="{DynamicResource BadgeBrush}" VerticalAlignment="Top">
            <TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                       Foreground="{DynamicResource AccentInkBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <TextBlock Text="{Binding Summary}" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       MaxHeight="34" Margin="0,4,0,6" ToolTip="{Binding Summary}"/>
            <WrapPanel>
              <TextBlock Text="{Binding Address}" FontSize="11"
                         Foreground="{DynamicResource AccentInkBrush}"
                         Margin="0,0,10,3"/>
              <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,3"/>
              <TextBlock Text="{Binding PlayerLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,3"/>
              <TextBlock Text="{Binding VersionLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,3"/>
              <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,3"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ServerItemTemplate">
      <Border Padding="8,7" BorderBrush="{DynamicResource BorderBrushTheme}"
              BorderThickness="0,0,0,1" MinHeight="50">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                     Foreground="{DynamicResource AccentInkBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <TextBlock Text="{Binding Address}" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Address}"
                       Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="LocalResourceItemTemplate">
      <Border Padding="8,6" BorderBrush="{DynamicResource BorderBrushTheme}"
              BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="62"/>
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" Margin="0,0,8,0" CornerRadius="4"
                  Background="{DynamicResource BadgeBrush}" VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMod}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid Margin="3">
              <Path x:Name="LocalModFallback" Width="20" Height="20" Stretch="Uniform"
                    Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="1.6"
                    StrokeLineJoin="Round" Data="M 2,6 L 10,2 18,6 18,14 10,18 2,14 Z M 2,6 L 10,10 18,6 M 10,10 L 10,18">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
              <Image x:Name="LocalModThumbnail" Source="{Binding Icon}" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>
          <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                     Foreground="{DynamicResource AccentInkBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMod}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" ToolTip="{Binding FullPath}"/>
          <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="11" Foreground="{DynamicResource MutedBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="已启用"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Disabled}" Value="True">
                    <Setter Property="Text" Value="已停用"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </DataTemplate>
    <!-- Skin downloads use the same rich image/title/metadata layout as Modrinth.
         Thumbnails are decoded with strict limits by OnlineSkinSearchService,
         not fetched automatically from an arbitrary Binding URL. -->
    <DataTemplate x:Key="OnlineSkinResultTemplate">
      <Border Padding="8,7" MinHeight="78"
              BorderBrush="{DynamicResource SoftDividerBrush}"
              BorderThickness="0,0,0,1" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="61"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="58" VerticalAlignment="Center"
                  CornerRadius="4" ClipToBounds="True"
                  Background="{DynamicResource BadgeBrush}">
            <Grid>
              <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                         Foreground="{DynamicResource AccentInkBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                     Width="48" Height="58"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxHeight="22"
                       ToolTip="{Binding Name}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"
                       MaxHeight="33" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MutedBrush}"
                       ToolTip="{Binding Summary}" Margin="0,0,0,6"/>
            <WrapPanel>
              <Border Style="{StaticResource SkinMetaBadge}">
                <TextBlock Text="{Binding Source}" FontSize="10.5"
                           Foreground="{DynamicResource AccentInkBrush}"/>
              </Border>
              <TextBlock Text="{Binding AuthorLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="0,0,9,2" TextTrimming="CharacterEllipsis"
                         MaxWidth="135"/>
              <TextBlock Text="{Binding ModelLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="0,0,9,2"/>
              <TextBlock Text="{Binding DownloadsLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,0,9,2"/>
              <TextBlock Text="{Binding LicenseLabel}" FontSize="11"
                         Foreground="{DynamicResource AccentInkBrush}"
                         Margin="0,0,9,2"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ResourceItemTemplate">
      <Border Padding="8,7" BorderBrush="{DynamicResource BorderBrushTheme}"
              BorderThickness="0,0,0,1" Background="Transparent" MinHeight="70">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="39" Height="39" VerticalAlignment="Top"
                  Background="{DynamicResource BadgeBrush}" CornerRadius="4">
            <Grid>
              <TextBlock Text="&#xE8B7;" FontSize="19" FontFamily="Segoe MDL2 Assets"
                         Foreground="{DynamicResource AccentInkBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Source="{Binding IconUrl}" Width="39" Height="39"
                     ToolTip="{Binding IconDescription}"
                     Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <WrapPanel Margin="0,0,0,5">
              <TextBlock Text="{Binding Name}" FontSize="14"
                         FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"
                         ToolTip="{Binding Name}" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding Author}" FontSize="12"
                         Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Bottom"/>
            </WrapPanel>
            <TextBlock Text="{Binding Description}" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       LineHeight="16" MaxHeight="32" ToolTip="{Binding Description}"
                       Margin="0,0,0,7"/>
            <WrapPanel>
              <TextBlock Text="{Binding CategoryLabel}" FontSize="11"
                         Foreground="{DynamicResource AccentInkBrush}"
                         Margin="0,0,15,3"/>
              <TextBlock Text="{Binding LoaderLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="0,0,15,3"/>
              <TextBlock Text="{Binding VersionsLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}"
                         TextTrimming="CharacterEllipsis" MaxWidth="170"
                         ToolTip="{Binding VersionsLabel}" Margin="0,0,15,3"/>
              <TextBlock Text="{Binding DownloadsLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="0,0,15,3"/>
              <TextBlock Text="{Binding UpdatedLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="0,0,15,3"/>
              <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="0,0,15,3"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="VersionItemTemplate">
      <Border Padding="8,6" BorderBrush="{DynamicResource SoftDividerBrush}"
              BorderThickness="0,0,0,1" MinHeight="46">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="106"/>
          </Grid.ColumnDefinitions>
          <Border Width="33" Height="33" CornerRadius="4"
                  Background="{DynamicResource BadgeBrush}" VerticalAlignment="Center">
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                       FontSize="17" Foreground="{DynamicResource AccentInkBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Category}" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center"
                      HorizontalAlignment="Right">
            <TextBlock Text="{Binding Released, StringFormat={}{0:yyyy-MM-dd}}"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11.5"
                       HorizontalAlignment="Right" Margin="0,5,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="DownloadItemTemplate">
      <Border Padding="9,8" BorderBrush="{DynamicResource SoftDividerBrush}"
              BorderThickness="0,0,0,1" MinHeight="76">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="117"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
            <WrapPanel Margin="0,0,0,4">
              <TextBlock Text="{Binding Kind}" FontSize="10.5"
                         Foreground="{DynamicResource AccentInkBrush}"
                         Margin="0,0,11,0" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                         TextWrapping="Wrap"/>
            </WrapPanel>
            <TextBlock Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis" MaxHeight="37"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentInkBrush}"
                       HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding PercentLabel}" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Speed}" FontSize="10.5"
                       Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Right" Margin="0,3,0,0"/>
          </StackPanel>
          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                       Height="5" Margin="0,6,0,0" Minimum="0" Maximum="100"
                       Value="{Binding Percent, Mode=OneWay}"
                       IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Application.Resources>
</Application>
