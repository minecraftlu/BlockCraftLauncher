<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- Explicitly copy transitive NuGet dependencies into the WPF EXE directory. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- Explicit x64 CLR process: match 64-bit native WebView2Loader.dll -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BlockCraftLauncher.Wpf</AssemblyName>
    <RootNamespace>BlockCraftLauncher.Wpf</RootNamespace>
    <ApplicationIcon>Assets\blockcraft_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.9.46.0</Version>
    <!-- Windows File Properties descriptive metadata. Not Authenticode signing. -->
    <Company>晓银</Company>
    <Authors>晓银</Authors>
    <Product>BlockCraft Launcher</Product>
    <AssemblyTitle>BlockCraft Launcher WPF</AssemblyTitle>
    <Description>BlockCraft Launcher - Minecraft Java Edition 启动器</Description>
    <Copyright>Copyright © 2026 晓银</Copyright>
    <FileVersion>0.9.46.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="CmlLib.Core.Commons" Version="4.0.0" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.4.0" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.IO.Compression" />
    <Resource Include="Assets\blockcraft_icon.png" />
    <Resource Include="Assets\blockcraft_icon.ico" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
