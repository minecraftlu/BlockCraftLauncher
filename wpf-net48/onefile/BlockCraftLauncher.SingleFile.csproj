<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BlockCraftLauncher</AssemblyName>
    <RootNamespace>BlockCraftLauncher.OneFile</RootNamespace>
    <ApplicationIcon>..\src\BlockCraftLauncher.Wpf\Assets\blockcraft_icon.ico</ApplicationIcon>
    <Version>0.9.45.0</Version>
    <!-- Windows File Properties descriptive metadata. Not Authenticode signing. -->
    <Company>晓银</Company>
    <Authors>晓银</Authors>
    <Product>BlockCraft Launcher</Product>
    <AssemblyTitle>BlockCraft Launcher</AssemblyTitle>
    <Description>BlockCraft Launcher - Minecraft Java Edition 启动器</Description>
    <Copyright>Copyright © 2026 晓银</Copyright>
    <FileVersion>0.9.45.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="..\dist\BlockCraftLauncher.OneFile.Payload.zip"
                      LogicalName="BlockCraftLauncher.Payload.zip" />
  </ItemGroup>
</Project>